{
  "rewrites": [
    {
      "source": "/auth/(.*)",
      "destination": "https://swahilisme-platform-production-b5b9.up.railway.app/auth/$1"
    },
    {
      "source": "/api/v1/(.*)",
      "destination": "https://swahilisme-platform-production-b5b9.up.railway.app/api/v1/$1"
    },
    {
      "source": "/((?!auth|api/v1).*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "REACT_APP_API_URL": "https://swahilisme-platform-production-b5b9.up.railway.app",
    "SKIP_PREFLIGHT_CHECK": "true",
    "TSC_COMPILE_ON_ERROR": "true",
    "DISABLE_ESLINT_PLUGIN": "true"
  },
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "framework": "create-react-app"
}
