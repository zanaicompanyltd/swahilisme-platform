# SwahiliSME Platform Environment Variables

# App
APP_ENV=development
SECRET_KEY=your-secret-key-here
DEBUG=True

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/swahilisme_db
SQLITE_PATH=./data/offline.sqlite

# AI / LLM
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key
WHISPER_MODEL=small

# WhatsApp
WHATSAPP_TOKEN=your-meta-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-id
WHATSAPP_VERIFY_TOKEN=swahilisme_verify_2026

# Redis
REDIS_URL=redis://localhost:6379/0

# PDF
PDF_OUTPUT_DIR=./reports

# RAG
VECTOR_STORE_PATH=./data/processed/vector_store
CONFIDENCE_THRESHOLD=0.75
ESCALATION_THRESHOLD=0.50
